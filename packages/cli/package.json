{
  "name": "comment-everything",
  "version": "0.1.1",
  "description": "Comment on HTML, Markdown, web pages and media, then hand the comments to Claude Code or any MCP agent.",
  "keywords": [
    "mcp",
    "claude",
    "claude-code",
    "annotations",
    "review",
    "comments",
    "markdown",
    "html",
    "video"
  ],
  "homepage": "https://github.com/hdduytran/comment-everything#readme",
  "bugs": {
    "url": "https://github.com/hdduytran/comment-everything/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hdduytran/comment-everything.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Comment Everything contributors",
  "type": "module",
  "bin": {
    "comment-everything": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-viewer-bundle.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "chokidar": "^4.0.3",
    "hono": "^4.10.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@comment-everything/core": "workspace:*",
    "@comment-everything/daemon": "workspace:*",
    "@comment-everything/viewer": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
