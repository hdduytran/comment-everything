{
  "name": "@comment-everything/core",
  "version": "0.1.0",
  "description": "Comment schema, storage, project-root resolution and prompt formatting for comment-everything.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/comment.schema.json": "./schema/comment.schema.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsup && node scripts/generate-json-schema.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "zod": "^4.1.0"
  }
}
